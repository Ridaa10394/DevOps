{
  "dashboard": {
    "uid": "s20-podinfo",
    "title": "Session 20 / podinfo",
    "tags": [
      "s20"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Healthy targets (up)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum(up{namespace=\"s20-app\",job=\"podinfo\"})"
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Request rate",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum(rate(http_requests_total{namespace=\"s20-app\"}[1m]))"
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Error ratio (5xx)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum(rate(http_requests_total{namespace=\"s20-app\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{namespace=\"s20-app\"}[1m]))"
          }
        ]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Firing alerts (podinfo)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "count(ALERTS{alertstate=\"firing\",alertname=~\"Podinfo.*\"}) or vector(0)"
          }
        ]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "CPU per pod (cores)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"s20-app\",container=\"podinfo\"}[1m]))",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Memory working set per pod",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"s20-app\",container=\"podinfo\"})",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Requests/s by status",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum by (status) (rate(http_requests_total{namespace=\"s20-app\"}[1m]))",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "p95 latency by path",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{namespace=\"s20-app\"}[1m])))",
            "legendFormat": "{{path}}"
          }
        ]
      }
    ]
  },
  "overwrite": true
}